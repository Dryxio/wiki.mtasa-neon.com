---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ template: 'splash', title: '404', description: 'Page not found in the Neon documentation.', tableOfContents: false }}>
  <main class="not-found">
    <span>LOST OUTSIDE THE MAP</span>
    <h2>404</h2>
    <p>There is no Neon page at this address.</p>
    <div><a href="/neon">Return to Neon →</a><a href="https://wiki.multitheftauto.com/wiki/Main_Page">Search the official MTA Wiki ↗</a></div>
  </main>
</StarlightPage>

<style>
  .not-found { max-width: 52rem; margin: 0 auto; padding: 5rem 1rem; }
  .not-found > span { color: #f28c18; font-size: .75rem; font-weight: 900; letter-spacing: .2em; }
  h2 { margin: .4rem 0; color: #f28c18; font-size: clamp(7rem, 25vw, 15rem); line-height: .8; text-shadow: .06em .06em 0 #542806; }
  p { color: var(--sl-color-gray-2); font-size: 1.2rem; }
  .not-found div { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2rem; }
  a { padding: .75rem 1rem; color: #f3eadc; border: 1px solid #55391e; background: #15120f; }
</style>
