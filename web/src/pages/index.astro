---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{
  template: 'splash',
  title: 'MTA:SA Neon Documentation',
  description: 'Choose the isolated Neon documentation or the preserved upstream MTA reference.',
  tableOfContents: false,
}}>
  <main class="gateway">
    <div class="gateway-kicker">ONE CODEBASE · TWO CLEAR REFERENCES</div>
    <h1>MTA:SA <span>NEON</span> Documentation</h1>
    <p class="gateway-lead">Neon extends Multi Theft Auto with experimental engine work. This documentation keeps those additions in their own unmistakable section while preserving the upstream MTA reference.</p>

    <div class="gateway-grid">
      <a class="gateway-card neon-card" href="/neon">
        <div class="card-label">NEON ONLY</div>
        <h2>Explore Neon additions</h2>
        <p>76 API entries, extended-world systems, native GTA services, compatibility rules, source commits, and test resources.</p>
        <strong>Open Neon documentation →</strong>
      </a>

      <a class="gateway-card upstream-card" href="/reference/Lua_API">
        <div class="card-label">UPSTREAM BASE</div>
        <h2>Browse the MTA reference</h2>
        <p>The standard MTA Lua API, events, elements, configuration, and articles inherited from the official data-driven wiki.</p>
        <strong>Open upstream reference →</strong>
      </a>
    </div>

    <p class="gateway-disclaimer">MTA:SA Neon is an independent experimental fork. It is not affiliated with or endorsed by the Multi Theft Auto team.</p>
  </main>
</StarlightPage>

<style>
  .gateway { max-width: 72rem; margin: 0 auto; padding: clamp(2rem, 7vw, 7rem) 1rem; }
  .gateway-kicker { color: #64f4ae; font-size: .8rem; font-weight: 800; letter-spacing: .22em; }
  h1 { max-width: 14ch; margin: .8rem 0 1.2rem; font-size: clamp(3rem, 8vw, 6.8rem); line-height: .9; letter-spacing: -.06em; }
  h1 span { color: #64f4ae; text-shadow: 0 0 40px rgba(100,244,174,.28); }
  .gateway-lead { max-width: 52rem; color: var(--sl-color-gray-2); font-size: clamp(1.05rem, 2vw, 1.3rem); }
  .gateway-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin: 3rem 0 2rem; }
  .gateway-card { position: relative; min-height: 18rem; padding: 2rem; overflow: hidden; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: 1.25rem; background: rgba(10,16,20,.72); transition: transform .2s ease, border-color .2s ease; }
  .gateway-card:hover { transform: translateY(-4px); }
  .gateway-card h2 { margin: 2.25rem 0 .8rem; font-size: 1.8rem; }
  .gateway-card p { color: var(--sl-color-gray-2); }
  .card-label { display: inline-flex; padding: .35rem .65rem; border-radius: 999px; font-size: .72rem; font-weight: 900; letter-spacing: .12em; }
  .neon-card { border-color: rgba(100,244,174,.5); background: radial-gradient(circle at 95% 0%, rgba(100,244,174,.18), transparent 44%), #07110e; }
  .neon-card:hover { border-color: #64f4ae; }
  .neon-card .card-label { color: #06110d; background: #64f4ae; }
  .neon-card strong { color: #64f4ae; }
  .upstream-card { background: radial-gradient(circle at 95% 0%, rgba(232,115,0,.16), transparent 44%), #11100d; }
  .upstream-card:hover { border-color: var(--color-mta-orange); }
  .upstream-card .card-label { color: white; background: var(--color-mta-orange); }
  .upstream-card strong { color: #f4a55d; }
  .gateway-disclaimer { color: var(--sl-color-gray-3); font-size: .88rem; }
  @media (max-width: 720px) { .gateway-grid { grid-template-columns: 1fr; } .gateway-card { min-height: 15rem; } }
</style>
