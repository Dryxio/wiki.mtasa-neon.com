---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { neonFunctions, neonCategories } from '@src/data/neon-functions';

const clientCount = neonFunctions.filter((entry) => entry.side === 'client').length;
const serverCount = neonFunctions.filter((entry) => entry.side === 'server').length;
const sharedCount = neonFunctions.filter((entry) => entry.side === 'shared').length;
---

<StarlightPage frontmatter={{
  template: 'doc',
  title: 'Neon',
  description: 'The features and APIs added or extended by MTA:SA Neon.',
  tableOfContents: false,
}}>
  <div class="neon-hero">
    <div class="neon-orbit" aria-hidden="true"></div>
    <p class="eyebrow">SAN ANDREAS · CUSTOM ENGINE</p>
    <h2>Push MTA:SA <span>beyond its original limits.</span></h2>
    <p class="hero-copy">Neon is an experimental engine fork for larger worlds, higher limits, deeper GTA systems, custom models, story tools, and new Lua APIs. It also brings FiveM-style shared NPCs and traffic into MTA, powered by GTA:SA's original single-player AI.</p>
    <div class="hero-actions">
      <a class="primary" href="https://github.com/Dryxio/mtasa-neon/releases/latest/download/MTA-Neon-Setup.exe">Download for Windows</a>
      <a href="/neon/features">See what Neon changes</a>
      <a href="/neon/synchronized-ai">Explore synchronized AI</a>
    </div>
  </div>

  <figure class="hero-shot">
    <img src="/neon-media/compare-project2dfx.jpg" width="2566" height="720" loading="eager" decoding="async"
         alt="Night view over the city: fogged out beyond a short distance in MTA:SA, full skyline with hundreds of distant lights in Neon" />
  </figure>

  <div class="stat-grid">
    <div><strong>{neonFunctions.length}</strong><span>documented API entries</span></div>
    <div><strong>{clientCount}</strong><span>client entries</span></div>
    <div><strong>{serverCount}</strong><span>server entries</span></div>
    <div><strong>{sharedCount}</strong><span>shared entries</span></div>
  </div>

  <section class="section-block">
    <p class="eyebrow">IN GAME</p>
    <h2>What it looks like</h2>
    <div class="shot-grid">
      <a href="/neon/world-objects">
        <img src="/neon-media/world-objects-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A cardboard box bound to a worldobject element, tracked with a live label next to a green objective zone" />
        <h3>Dynamic world objects</h3><p>Track, move, damage and break San Andreas' own physics props.</p>
      </a>
      <a href="/neon/runtime-collision">
        <img src="/neon-media/runtime-collision-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A long sloped ramp drawn in game, with its runtime-generated collision outline shown in cyan" />
        <h3>Runtime collision</h3><p>Build collision shapes from a Lua table and rebuild them live.</p>
      </a>
      <a href="/neon/foliage">
        <img src="/neon-media/foliage-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A triangle of native grass grown from Lua on a lawn at night" />
        <h3>Custom foliage</h3><p>Grow GTA's own vegetation anywhere, at any density.</p>
      </a>
      <a href="/neon/fire">
        <img src="/neon-media/fire-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A managed fire burning on the roof of a moving car it was retargeted onto" />
        <h3>Managed fire</h3><p>Synchronized fires that keep their identity and follow a target.</p>
      </a>
      <a href="/neon/birds">
        <img src="/neon-media/bird-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A large Lua-controlled flock of birds sweeping over the desert" />
        <h3>Scriptable birds</h3><p>Steerable flocks with their own renderer, past GTA's six slots.</p>
      </a>
      <a href="/neon/model-2dfx">
        <img src="/neon-media/2dfx-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A runway lined with ordinary GTA lamp posts running a colour wave from their native 2DFX lights" />
        <h3>Model 2DFX effects</h3><p>Drive the lights baked into GTA models, no custom assets.</p>
      </a>
      <a href="/neon/break-effects">
        <img src="/neon-media/break-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="An ordinary GTA prop breaking apart into fragments cut from its own mesh after being shot" />
        <h3>Object fracture</h3><p>Break any object into pieces cut from its own geometry.</p>
      </a>
      <a href="/neon/samp-maps">
        <img src="/neon-media/samp-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="A retextured SA-MP interior with brick, wood, tile and stone materials, none of them GTA defaults" />
        <h3>SA-MP maps</h3><p>Load Pawn exports directly, retextured material slots included.</p>
      </a>
      <a href="/neon/rendering-and-limits">
        <img src="/neon-media/cull-zone-poster.jpg" width="1280" height="720" loading="lazy" decoding="async" alt="Native CULL zone editing shown in game with 3D diagnostics" />
        <h3>Native CULL zones</h3><p>Create and edit GTA's culling volumes from a resource.</p>
      </a>
      <a href="/neon/skygfx">
        <img src="/neon-media/compare-skygfx.jpg" width="2566" height="720" loading="lazy" decoding="async" alt="Street-level view in Ganton: neutral colors in MTA:SA, warmer PS2-style grading in Neon" />
        <h3>PS2-style visuals</h3><p>Console-era color, blur and radiosity, built into the client.</p>
      </a>
      <a href="/neon/rendering-and-limits">
        <img src="/neon-media/compare-draw-distance.jpg" width="2566" height="720" loading="lazy" decoding="async" alt="Rooftop view over Los Santos: flat low-detail blobs in MTA:SA, detailed geometry in Neon" />
        <h3>Extended draw distance</h3><p>See the city instead of a fog wall, up to 5,000 units.</p>
      </a>
      <a href="/neon/client-experience">
        <img src="/neon-media/neon-main-menu.jpg" width="1920" height="1080" loading="lazy" decoding="async" alt="Neon main menu in the GTA:SA visual style with a Discord connected badge" />
        <h3>Neon client</h3><p>A GTA-style menu, server browser and optional Discord identity.</p>
      </a>
    </div>
  </section>

  <section class="section-block">
    <p class="eyebrow">SYSTEM MAP</p>
    <h2>What Neon changes under the hood</h2>
    <div class="system-grid">
      <a href="/neon/synchronized-ai"><span>01</span><h3>Synchronized NPCs & traffic</h3><p>Server-owned peds and mission actors driven by GTA's native AI, with one simulator and multiplayer presentation.</p></a>
      <a href="/neon/skygfx"><span>02</span><h3>PS2-style visuals</h3><p>Selected SkyGFX color, blur, radiosity, depth-bias, and YCbCr effects integrated into the Neon client.</p></a>
      <a href="/neon/client-experience"><span>03</span><h3>Neon client & servers</h3><p>A GTA-style menu, live server discovery, favorites, artwork, localization, and an integrated join flow.</p></a>
      <a href="/neon/story-runtime"><span>04</span><h3>Story runtime</h3><p>Native cutscenes, ped tasks, script cameras, mission audio and text, recorded cars, and co-op building blocks.</p></a>
      <a href="/neon/vehicle-audio"><span>05</span><h3>Custom vehicle audio</h3><p>Resource-owned engine sound configurations, synchronized opt-in modes, lifecycle cleanup, and backfires.</p></a>
      <a href="/neon/identity"><span>06</span><h3>Neon Identity</h3><p>Optional verified Neon and Discord identities for server policy, Lua resources, and stronger bans.</p></a>
      <a href="/neon/extended-world"><span>07</span><h3>Extended world</h3><p>A 20 km world range, extended water and radar, a dynamic F11 map, and large city resources.</p></a>
      <a href="/neon/native-world"><span>08</span><h3>Native world packs</h3><p>Server-delivered static worlds, strict auditing, one-shot authorization, native activation, and server isolation.</p></a>
      <a href="/neon/models-and-streaming"><span>09</span><h3>Custom models</h3><p>Stable server model IDs mapped to local GTA slots, with native-parent fallback and resource cleanup.</p></a>
      <a href="/neon/rendering-and-limits"><span>10</span><h3>Rendering & limits</h3><p>Larger native pools, live renderer stats, distant lights, editable CULL zones, and marker diagnostics.</p></a>
    </div>
  </section>

  <section class="status-strip">
    <div><p class="eyebrow">START WITH A REAL PATH</p><h2>Explore the mission checkpoints.</h2></div>
    <p>Tagging Up Turf and Drive-Thru connect the reusable story primitives into substantial paths exercised in game. Nines and AK's maps the next mission graph but still has an incomplete end-to-end matrix. The runtime provides building blocks for multiplayer coordination, while several multi-client barriers still need dedicated validation.</p>
    <a href="/neon/mission-checkpoints">See validated paths and open branches →</a>
  </section>

  <section class="section-block">
    <p class="eyebrow">API GROUPS</p>
    <div class="category-cloud">
      {Object.entries(neonCategories).map(([key, category]) => {
        const count = neonFunctions.filter((entry) => entry.category === key).length;
        return <a href={`/neon/functions#${key}`}><strong>{category.title}</strong><span>{count} entries</span></a>;
      })}
    </div>
  </section>

  <div class="neon-warning"><strong>Compatibility:</strong> Do not assume Neon APIs or network extensions exist on an ordinary MTA installation. Servers using current Neon-only model, native-world, or task-presentation protocols must keep client and server packages on the same network epoch.</div>
</StarlightPage>

<style>
  .neon-hero { position: relative; min-height: 30rem; display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 6vw, 5rem); overflow: hidden; border: 1px solid rgba(242,140,24,.35); border-radius: .35rem; background: radial-gradient(circle at 82% 30%, rgba(242,140,24,.16), transparent 30%), linear-gradient(135deg, #090807, #16110c); box-shadow: .5rem .5rem 0 rgba(87,42,5,.22); }
  .neon-orbit { position: absolute; right: -5rem; top: -8rem; width: 20rem; height: 34rem; opacity: .18; transform: rotate(32deg); border: 0; border-radius: 0; background: repeating-linear-gradient(180deg, #f28c18 0 3.2rem, transparent 3.2rem 5.8rem); }
  .eyebrow { margin: 0; color: #f28c18; font-size: .72rem; font-weight: 900; letter-spacing: .18em; }
  .neon-hero h2 { position: relative; max-width: 13ch; margin: 1rem 0; font-size: clamp(2.6rem, 6vw, 5.2rem); line-height: .94; letter-spacing: -.05em; }
  .neon-hero h2 span { color: #f28c18; text-shadow: .07em .07em 0 #582a06; }
  .hero-copy { position: relative; max-width: 48rem; color: var(--sl-color-gray-2); font-size: 1.08rem; }
  .hero-actions { position: relative; display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .hero-actions a { padding: .75rem 1rem; color: #f3eadc; text-decoration: none; border: 1px solid rgba(242,140,24,.38); border-radius: .2rem; background: #14110e; }
  .hero-actions .primary { color: #0a0806; font-weight: 800; background: #f28c18; box-shadow: .25rem .25rem 0 #5b2a06; }
  .hero-shot { margin: 1rem 0 0; }
  .hero-shot img { display: block; width: 100%; height: auto; border: 1px solid rgba(242,140,24,.35); border-radius: .35rem; }
  .shot-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.5rem; }
  .shot-grid a { display: flex; flex-direction: column; overflow: hidden; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .25rem; background: linear-gradient(145deg, rgba(242,140,24,.055), transparent); }
  .shot-grid a:hover { border-color: rgba(242,140,24,.72); transform: translateY(-2px); }
  .shot-grid img { display: block; width: 100%; height: 9rem; object-fit: cover; border-bottom: 1px solid var(--sl-color-gray-5); }
  .shot-grid h3 { margin: .9rem 1rem .3rem; font-size: 1rem; }
  .shot-grid p { margin: 0 1rem 1rem; color: var(--sl-color-gray-3); font-size: .85rem; }
  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 1fr; gap: .8rem; margin: 1rem 0 4rem; }
  .stat-grid div { display: flex; flex-direction: column; margin-top: 0; padding: 1.1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .8rem; background: var(--sl-color-bg-nav); }
  .stat-grid strong { color: #f28c18; font-size: 1.8rem; line-height: 1; }
  .stat-grid span { margin-top: .45rem; color: var(--sl-color-gray-3); font-size: .78rem; }
  .section-block { margin: 4rem 0; }
  .section-block > h2 { margin-top: .6rem; font-size: 2rem; }
  .system-grid { display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 1fr; gap: 1rem; margin-top: 1.5rem; }
  .system-grid a { padding: 1.4rem; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .25rem; background: linear-gradient(145deg, rgba(242,140,24,.055), transparent); }
  .system-grid a:hover { border-color: rgba(242,140,24,.72); transform: translateY(-2px); }
  .system-grid span { color: #f28c18; font-family: monospace; font-size: .75rem; }
  .system-grid h3 { margin: .75rem 0 .35rem; }
  .system-grid p { margin: 0; color: var(--sl-color-gray-3); }
  .status-strip { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2rem; padding: 2rem; border-left: 4px solid #f28c18; background: rgba(242,140,24,.065); }
  .status-strip h2 { margin: .7rem 0 0; font-size: 1.5rem; }
  .status-strip p { margin: 0; color: var(--sl-color-gray-2); }
  .status-strip > a { grid-column: 2; color: #ffad35; font-weight: 700; }
  .category-cloud { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-top: 1rem; }
  .category-cloud a { display: flex; flex-direction: column; padding: 1rem; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; }
  .category-cloud a:hover { border-color: #f28c18; }
  .category-cloud span { color: var(--sl-color-gray-3); font-size: .78rem; }
  .neon-warning { margin-top: 3rem; padding: 1rem 1.2rem; border: 1px solid rgba(242,140,24,.28); border-radius: .2rem; background: rgba(242,140,24,.055); }
  @media (max-width: 780px) { .stat-grid { grid-template-columns: repeat(2,1fr); } .system-grid, .status-strip { grid-template-columns: 1fr; } .status-strip > a { grid-column: 1; } .category-cloud { grid-template-columns: 1fr 1fr; } .shot-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .category-cloud { grid-template-columns: 1fr; } .shot-grid { grid-template-columns: 1fr; } }
</style>
