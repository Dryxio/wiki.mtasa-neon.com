---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { neonFunctions, neonCategories, neonTaskGroups } from '@src/data/neon-functions';

const journeys = [
  {
    title: 'Build a story mission',
    description: 'Native actors, task sequences, cameras, cutscenes, mission text, and audio.',
    guide: '/neon/story-runtime',
    functions: ['setPedTaskSequence', 'acquireScriptCamera', 'acquireMissionText'],
  },
  {
    title: 'Extend the world',
    description: 'Add models, radar tiles, water boundaries, and native world behavior.',
    guide: '/neon/extended-world',
    functions: ['engineRequestModel', 'engineSetRadarMapTile', 'engineCreateCullZone'],
  },
  {
    title: 'Diagnose limits',
    description: 'Inspect renderer budgets, distant lights, markers, and runtime capacity.',
    guide: '/neon/rendering-and-limits',
    functions: ['engineGetRendererStats', 'engineGetDistantLightStats', 'getMarkerLimitStats'],
  },
  {
    title: 'Customize vehicle audio',
    description: 'Own one client configuration, reload it safely, and trigger configured backfires.',
    guide: '/neon/vehicle-audio',
    functions: ['engineLoadVehicleAudioConfig', 'engineReloadVehicleAudioConfig', 'enginePlayVehicleAudioBackfire'],
  },
  {
    title: 'Use verified identity',
    description: 'Read verified player IDs and make server bans aware of Neon and Discord identities.',
    guide: '/neon/identity',
    functions: ['isPlayerNeonAuthenticated', 'getPlayerNeonID', 'addBan'],
  },
  {
    title: 'Synchronize native AI',
    description: 'Run GTA pedestrian and road-traffic behavior on one owner and synchronize the result for other players.',
    guide: '/neon/synchronized-ai',
    functions: ['setPedWander', 'getAmbientVehicleSpawnCandidate', 'acquirePedNativeEventProfile'],
  },
] as const;

const categoryEntries = Object.entries(neonCategories).map(([key, category]) => ({
  key,
  category,
  entries: neonFunctions.filter((entry) => entry.category === key),
}));

const searchableText = (entry: (typeof neonFunctions)[number], categoryTitle: string) => [
  entry.name,
  entry.signature,
  entry.summary,
  categoryTitle,
  entry.nativeTask?.tasks?.join(' '),
  entry.nativeTask?.command,
  entry.nativeTask?.opcode,
].filter(Boolean).join(' ').toLowerCase();
---

<StarlightPage frontmatter={{ template: 'doc', title: 'Neon Lua API', description: 'Functions added or extended by MTA:SA Neon.', tableOfContents: false }}>
  <div class="neon-api-intro">
    <span>NEON-ONLY REFERENCE</span>
    <h2>{neonFunctions.length} documented API entries</h2>
    <p>Search the functions registered by Neon, browse them by system, or follow a practical path into the engine.</p>
  </div>

  <section class="journeys" aria-labelledby="journeys-title">
    <div class="section-heading">
      <p>START WITH A GOAL</p>
      <h2 id="journeys-title">Choose a path</h2>
    </div>
    <div class="journey-grid">
      {journeys.map((journey) => <article>
        <h3><a href={journey.guide}>{journey.title} →</a></h3>
        <p>{journey.description}</p>
        <ul>{journey.functions.map((name) => <li><a href={`/neon/functions/${name}`}><code>{name}</code></a></li>)}</ul>
      </article>)}
    </div>
  </section>

  <div class="api-explorer" data-api-explorer>
    <div class="explorer-controls" data-explorer-controls hidden>
      <div class="search-row">
        <div class="search-field">
          <label for="api-search">Search the Neon API</label>
          <div><input id="api-search" type="search" autocomplete="off" placeholder="Function, CTask, command, opcode…" data-api-search /><button type="button" data-clear-search hidden>Clear</button></div>
        </div>
        <p class="result-count" aria-live="polite" data-result-count>{neonFunctions.length} APIs</p>
        <button class="reset-button" type="button" data-reset-filters hidden>Reset filters</button>
      </div>
      <div class="filter-row">
        <fieldset>
          <legend>Side</legend>
          {['all', 'client', 'server', 'shared'].map((value) => <button type="button" data-filter-group="side" data-filter-value={value} aria-pressed={value === 'all' ? 'true' : 'false'}>{value === 'all' ? 'All sides' : value}</button>)}
        </fieldset>
        <fieldset>
          <legend>API type</legend>
          {[['all', 'All APIs'], ['neon', 'Neon'], ['extension', 'MTA extension']].map(([value, label]) => <button type="button" data-filter-group="kind" data-filter-value={value} aria-pressed={value === 'all' ? 'true' : 'false'}>{label}</button>)}
        </fieldset>
        <div class="toggle-filters" aria-label="Native mapping filters">
          <button type="button" data-toggle-filter="mapping" aria-pressed="false">GTA mapping</button>
          <button type="button" data-toggle-filter="opcode" aria-pressed="false">SCM opcode</button>
        </div>
      </div>
    </div>

    <nav class="category-directory" aria-labelledby="categories-title">
      <div class="section-heading">
        <p>BROWSE THE SYSTEMS</p>
        <h2 id="categories-title">Jump to a category</h2>
      </div>
      <div class="category-links">
        {categoryEntries.map(({ key, category, entries }) => entries.length > 0 && <a href={`#${key}`} data-category-link={key}>
          <span>{category.title}</span><strong data-category-count>{entries.length}</strong>
        </a>)}
      </div>
    </nav>

    <div class="no-results" data-no-results hidden>
      <strong>No matching APIs.</strong>
      <span>Try a broader search or clear the active filters.</span>
      <button type="button" data-reset-filters>Show all APIs</button>
    </div>

    {categoryEntries.map(({ key, category, entries }) => {
      if (entries.length === 0) return null;
      const groups = key === 'tasks'
        ? Object.entries(neonTaskGroups).map(([groupKey, label]) => ({ groupKey, label, entries: entries.filter((entry) => entry.group === groupKey) }))
        : [{ groupKey: '', label: '', entries }];

      return <section class="api-category" id={key} data-api-category={key}>
        <div class="category-heading"><div><p><span data-section-count>{entries.length}</span> ENTRIES</p><h2>{category.title}</h2></div><a href={category.guide}>System guide →</a></div>
        {groups.map((group) => group.entries.length > 0 && <div class="api-subgroup" data-api-group={group.groupKey || undefined}>
          {group.label && <div class="subgroup-heading"><h3>{group.label}</h3><span><span data-group-count>{group.entries.length}</span> APIs</span></div>}
          <div class="api-table">
            {group.entries.map((entry) => <a
              href={`/neon/functions/${entry.name}`}
              data-api-entry
              data-search={searchableText(entry, category.title)}
              data-side={entry.side}
              data-kind={entry.extension ? 'extension' : 'neon'}
              data-mapping={entry.nativeTask ? 'true' : 'false'}
              data-opcode={entry.nativeTask?.opcode ? 'true' : 'false'}
            >
              <div><code>{entry.name}</code>{entry.extension && <span class="extension">EXTENSION</span>}</div>
              <p>{entry.summary}</p>
              <span class={`side side-${entry.side}`}>{entry.side === 'shared' ? 'client + server' : entry.side}</span>
            </a>)}
          </div>
        </div>)}
      </section>;
    })}
  </div>
</StarlightPage>

<script>
  const explorer = document.querySelector('[data-api-explorer]');

  if (explorer instanceof HTMLElement) {
    const controls = explorer.querySelector('[data-explorer-controls]');
    const search = explorer.querySelector('[data-api-search]');
    const entries = [...explorer.querySelectorAll('[data-api-entry]')];
    const sections = [...explorer.querySelectorAll('[data-api-category]')];
    const resultCount = explorer.querySelector('[data-result-count]');
    const noResults = explorer.querySelector('[data-no-results]');
    const clearSearch = explorer.querySelector('[data-clear-search]');
    const resetButtons = [...explorer.querySelectorAll('[data-reset-filters]')];
    const filterButtons = [...explorer.querySelectorAll('[data-filter-group]')];
    const toggleButtons = [...explorer.querySelectorAll('[data-toggle-filter]')];
    const validSides = ['all', 'client', 'server', 'shared'];
    const validKinds = ['all', 'neon', 'extension'];
    const params = new URLSearchParams(window.location.search);
    const state = {
      query: params.get('q') || '',
      side: validSides.includes(params.get('side') || '') ? params.get('side') : 'all',
      kind: validKinds.includes(params.get('type') || '') ? params.get('type') : 'all',
      mapping: params.get('gta') === '1',
      opcode: params.get('scm') === '1',
    };

    const isActive = () => Boolean(state.query || state.side !== 'all' || state.kind !== 'all' || state.mapping || state.opcode);

    const syncUrl = () => {
      const url = new URL(window.location.href);
      const setOrDelete = (key, value, fallback = '') => value && value !== fallback ? url.searchParams.set(key, value) : url.searchParams.delete(key);
      setOrDelete('q', state.query);
      setOrDelete('side', state.side, 'all');
      setOrDelete('type', state.kind, 'all');
      setOrDelete('gta', state.mapping ? '1' : '');
      setOrDelete('scm', state.opcode ? '1' : '');
      window.history.replaceState(window.history.state, '', url);
    };

    const applyFilters = () => {
      const query = state.query.trim().toLowerCase();
      let visibleTotal = 0;

      entries.forEach((entry) => {
        const matches = (!query || entry.getAttribute('data-search')?.includes(query))
          && (state.side === 'all' || entry.getAttribute('data-side') === state.side)
          && (state.kind === 'all' || entry.getAttribute('data-kind') === state.kind)
          && (!state.mapping || entry.getAttribute('data-mapping') === 'true')
          && (!state.opcode || entry.getAttribute('data-opcode') === 'true');
        entry.toggleAttribute('hidden', !matches);
        if (matches) visibleTotal += 1;
      });

      sections.forEach((section) => {
        const category = section.getAttribute('data-api-category');
        const visible = section.querySelectorAll('[data-api-entry]:not([hidden])').length;
        section.toggleAttribute('hidden', visible === 0);
        const sectionCount = section.querySelector('[data-section-count]');
        if (sectionCount) sectionCount.textContent = String(visible);
        section.querySelectorAll('[data-api-group]').forEach((group) => {
          const groupVisible = group.querySelectorAll('[data-api-entry]:not([hidden])').length;
          group.toggleAttribute('hidden', groupVisible === 0);
          const groupCount = group.querySelector('[data-group-count]');
          if (groupCount) groupCount.textContent = String(groupVisible);
        });
        const categoryLink = document.querySelector(`[data-category-link="${category}"]`);
        categoryLink?.toggleAttribute('hidden', visible === 0);
        const categoryCount = categoryLink?.querySelector('[data-category-count]');
        if (categoryCount) categoryCount.textContent = String(visible);
      });

      if (resultCount) resultCount.textContent = `${visibleTotal} ${visibleTotal === 1 ? 'API' : 'APIs'}`;
      noResults?.toggleAttribute('hidden', visibleTotal !== 0);
      clearSearch?.toggleAttribute('hidden', !state.query);
      resetButtons.forEach((button) => button.toggleAttribute('hidden', !isActive()));
      filterButtons.forEach((button) => button.setAttribute('aria-pressed', String(state[button.getAttribute('data-filter-group')] === button.getAttribute('data-filter-value'))));
      toggleButtons.forEach((button) => button.setAttribute('aria-pressed', String(Boolean(state[button.getAttribute('data-toggle-filter')]))));
      syncUrl();
    };

    if (controls instanceof HTMLElement && search instanceof HTMLInputElement) {
      controls.hidden = false;
      search.value = state.query;
      search.addEventListener('input', () => { state.query = search.value; applyFilters(); });
      search.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && state.query) { state.query = ''; search.value = ''; applyFilters(); }
      });
      clearSearch?.addEventListener('click', () => { state.query = ''; search.value = ''; search.focus(); applyFilters(); });
      filterButtons.forEach((button) => button.addEventListener('click', () => {
        state[button.getAttribute('data-filter-group')] = button.getAttribute('data-filter-value');
        applyFilters();
      }));
      toggleButtons.forEach((button) => button.addEventListener('click', () => {
        const key = button.getAttribute('data-toggle-filter');
        state[key] = !state[key];
        applyFilters();
      }));
      resetButtons.forEach((button) => button.addEventListener('click', () => {
        state.query = ''; state.side = 'all'; state.kind = 'all'; state.mapping = false; state.opcode = false; search.value = ''; applyFilters(); search.focus();
      }));
      applyFilters();
      const initialHash = window.location.hash.slice(1);
      if (initialHash) {
        window.requestAnimationFrame(() => document.getElementById(decodeURIComponent(initialHash))?.scrollIntoView());
      }
    }
  }
</script>

<style>
  .neon-api-intro { padding: 1.5rem; border: 1px solid rgba(242,140,24,.38); border-radius: .5rem; background: linear-gradient(135deg, rgba(242,140,24,.11), transparent); box-shadow: .35rem .35rem 0 rgba(91,42,6,.18); }
  .neon-api-intro > span, .section-heading > p, .category-heading p { margin: 0; color: #f28c18; font-size: .7rem; font-weight: 900; letter-spacing: .15em; }
  .neon-api-intro h2 { margin: .5rem 0; }
  .neon-api-intro p { margin-bottom: 0; color: var(--sl-color-gray-2); }
  .journeys, .category-directory { margin: 3rem 0; }
  .section-heading h2 { margin: .3rem 0 1rem; }
  .journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: 1fr; gap: .8rem; }
  .journey-grid article { min-width: 0; margin-top: 0; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; background: rgba(242,140,24,.035); }
  .journey-grid h3 { margin: 0; font-size: 1.05rem; }
  .journey-grid h3 a { color: #ffad35; text-decoration: none; }
  .journey-grid p { margin: .6rem 0 .8rem; color: var(--sl-color-gray-3); font-size: .85rem; }
  .journey-grid ul { display: flex; flex-wrap: wrap; gap: .35rem; margin: 0; padding: 0; list-style: none; }
  .journey-grid li { min-width: 0; }
  .journey-grid li a { text-decoration: none; }
  .journey-grid code { overflow-wrap: anywhere; font-size: .72rem; }
  .category-links { display: flex; flex-wrap: wrap; gap: .45rem; }
  .category-links a { display: inline-flex; align-items: center; gap: .5rem; padding: .45rem .65rem; color: var(--sl-color-gray-2); text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: 999px; font-size: .76rem; }
  .category-links a:hover { color: #ffad35; border-color: rgba(242,140,24,.7); }
  .category-links strong { display: grid; place-items: center; min-width: 1.35rem; height: 1.35rem; color: #ffbd5c; background: rgba(242,140,24,.1); border-radius: 999px; font-size: .65rem; }
  .explorer-controls { z-index: 5; margin: 2.5rem 0 1rem; padding: .85rem; border: 1px solid rgba(242,140,24,.38); border-radius: .7rem; background: rgba(15,13,11,.97); box-shadow: 0 .5rem 1.5rem rgba(0,0,0,.25); }
  .search-row { display: grid; grid-template-columns: minmax(15rem, 1fr) auto auto; align-items: end; gap: .65rem; }
  .search-field label { display: block; margin-bottom: .35rem; color: var(--sl-color-gray-2); font-size: .76rem; font-weight: 800; }
  .search-field > div { display: flex; }
  .search-field input { width: 100%; min-width: 0; padding: .62rem .75rem; color: var(--sl-color-white); background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-4); border-radius: .4rem 0 0 .4rem; }
  .search-field button { padding: .55rem .7rem; color: #ffbd5c; background: var(--sl-color-bg-nav); border: 1px solid var(--sl-color-gray-4); border-left: 0; border-radius: 0 .4rem .4rem 0; }
  .result-count { margin: 0 0 .55rem; color: #ffbd5c; font-size: .8rem; font-weight: 800; white-space: nowrap; }
  .reset-button { margin-bottom: .3rem; }
  .filter-row { display: flex; flex-wrap: wrap; align-items: end; gap: .6rem 1rem; margin-top: .7rem; }
  .filter-row fieldset { display: flex; gap: .3rem; margin: 0; padding: 0; border: 0; }
  .filter-row legend { float: left; margin-right: .4rem; padding-top: .35rem; color: var(--sl-color-gray-3); font-size: .7rem; font-weight: 800; }
  .filter-row button, .reset-button, .no-results button { padding: .38rem .55rem; color: var(--sl-color-gray-2); background: transparent; border: 1px solid var(--sl-color-gray-5); border-radius: .35rem; font-size: .7rem; font-weight: 750; }
  .filter-row button[aria-pressed="true"] { color: #0a0806; background: #f28c18; border-color: #f28c18; }
  .toggle-filters { display: flex; gap: .3rem; }
  .toggle-filters button { margin-top: 0; }
  .reset-button, .no-results button { color: #ffad35; }
  .no-results { margin: 2rem 0; padding: 1.2rem; border: 1px dashed var(--sl-color-gray-4); border-radius: .7rem; text-align: center; }
  .no-results span { display: block; margin: .25rem 0 .8rem; color: var(--sl-color-gray-3); }
  .api-category { margin: 4rem 0; content-visibility: auto; contain-intrinsic-size: auto 40rem; scroll-margin-top: 5rem; }
  .category-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .category-heading h2 { margin: .3rem 0 0; }
  .category-heading a { color: #ffad35; font-size: .85rem; }
  .api-subgroup + .api-subgroup { margin-top: 2rem; }
  .subgroup-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .65rem; padding-bottom: .4rem; border-bottom: 1px solid var(--sl-color-gray-5); }
  .subgroup-heading h3 { margin: 0; font-size: 1rem; }
  .subgroup-heading > span { color: var(--sl-color-gray-3); font-size: .68rem; font-weight: 800; }
  .api-table { display: grid; gap: .55rem; }
  .api-table > a { display: grid; grid-template-columns: minmax(14rem, .75fr) 1.5fr auto; align-items: center; gap: 1rem; padding: .85rem 1rem; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; }
  .api-table > a:hover { border-color: rgba(242,140,24,.75); background: rgba(242,140,24,.05); transform: translateX(3px); }
  .api-table > a > div { min-width: 0; }
  .api-table code { overflow-wrap: anywhere; white-space: normal; }
  .api-table p { margin: 0; color: var(--sl-color-gray-3); font-size: .86rem; }
  .extension { margin-left: .5rem; padding: .15rem .35rem; color: #ffc274; border: 1px solid rgba(242,140,24,.55); border-radius: .15rem; font-size: .58rem; font-weight: 900; }
  .side { padding: .22rem .45rem; border-radius: 999px; font-size: .66rem; font-weight: 800; white-space: nowrap; }
  .side-client { color: #ff9191; background: rgba(221,91,91,.12); }
  .side-server { color: #f6a11a; background: rgba(246,161,26,.12); }
  .side-shared { color: #d5cec5; background: rgba(213,206,197,.1); }
  :is(.category-links a, .journey-grid a, .explorer-controls button, .explorer-controls input, .no-results button, .api-table > a):focus-visible { outline: 2px solid #ffad35; outline-offset: 3px; }
  @media (min-width: 1000px) and (min-height: 700px) { .explorer-controls { position: sticky; top: 4.5rem; } .api-category { scroll-margin-top: 18rem; } }
  @media (max-width: 900px) { .journey-grid { grid-template-columns: 1fr; } .explorer-controls { position: static; } }
  @media (max-width: 820px) { .api-table > a { grid-template-columns: 1fr auto; } .api-table p { grid-column: 1 / -1; grid-row: 2; } }
  @media (max-width: 620px) { .search-row { grid-template-columns: 1fr auto; } .search-field { grid-column: 1 / -1; } .filter-row { display: grid; } .filter-row fieldset { flex-wrap: wrap; } .filter-row legend { width: 100%; } .category-heading { align-items: start; flex-direction: column; } }
</style>
