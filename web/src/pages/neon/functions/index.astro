---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { neonFunctions, neonCategories } from '@src/data/neon-functions';
---

<StarlightPage frontmatter={{ template: 'doc', title: 'Neon Lua API', description: 'Functions added or extended by MTA:SA Neon.', tableOfContents: false }}>
  <div class="neon-api-intro">
    <span>NEON-ONLY REFERENCE</span>
    <h2>{neonFunctions.length} documented API entries</h2>
    <p>This list comes straight from Neon's registered functions and commit history. It includes five server-side model inspection functions missing from the engine README, and labels extensions to existing MTA APIs.</p>
  </div>

  {Object.entries(neonCategories).map(([key, category]) => {
    const entries = neonFunctions.filter((entry) => entry.category === key);
    return entries.length > 0 && <section class="api-category" id={key}>
      <div class="category-heading"><div><p>{entries.length} ENTRIES</p><h2>{category.title}</h2></div><a href={category.guide}>System guide →</a></div>
      <div class="api-table">
        {entries.map((entry) => <a href={`/neon/functions/${entry.name}`}>
          <div><code>{entry.name}</code>{entry.extension && <span class="extension">EXTENSION</span>}</div>
          <p>{entry.summary}</p>
          <span class={`side side-${entry.side}`}>{entry.side === 'shared' ? 'client + server' : entry.side}</span>
        </a>)}
      </div>
    </section>;
  })}
</StarlightPage>

<style>
  .neon-api-intro { padding: 1.5rem; border: 1px solid rgba(242,140,24,.38); border-radius: .25rem; background: linear-gradient(135deg, rgba(242,140,24,.11), transparent); box-shadow: .35rem .35rem 0 rgba(91,42,6,.18); }
  .neon-api-intro > span, .category-heading p { margin: 0; color: #f28c18; font-size: .7rem; font-weight: 900; letter-spacing: .15em; }
  .neon-api-intro h2 { margin: .5rem 0; }
  .neon-api-intro p { margin-bottom: 0; color: var(--sl-color-gray-2); }
  .api-category { margin: 4rem 0; content-visibility: auto; contain-intrinsic-size: auto 40rem; scroll-margin-top: 5rem; }
  .category-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .category-heading h2 { margin: .3rem 0 0; }
  .category-heading a { color: #ffad35; font-size: .85rem; }
  .api-table { display: grid; gap: .55rem; }
  .api-table > a { display: grid; grid-template-columns: minmax(14rem, .75fr) 1.5fr auto; align-items: center; gap: 1rem; padding: .85rem 1rem; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; }
  .api-table > a:hover { border-color: rgba(242,140,24,.75); background: rgba(242,140,24,.05); transform: translateX(3px); }
  .api-table p { margin: 0; color: var(--sl-color-gray-3); font-size: .86rem; }
  .extension { margin-left: .5rem; padding: .15rem .35rem; color: #ffc274; border: 1px solid rgba(242,140,24,.55); border-radius: .15rem; font-size: .58rem; font-weight: 900; }
  .side { padding: .22rem .45rem; border-radius: 999px; font-size: .66rem; font-weight: 800; white-space: nowrap; }
  .side-client { color: #ff9191; background: rgba(221,91,91,.12); }
  .side-server { color: #f6a11a; background: rgba(246,161,26,.12); }
  .side-shared { color: #d5cec5; background: rgba(213,206,197,.1); }
  @media (max-width: 820px) { .api-table > a { grid-template-columns: 1fr auto; } .api-table p { grid-column: 1 / -1; grid-row: 2; } }
</style>
