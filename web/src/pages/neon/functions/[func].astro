---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { neonFunctions, neonCategories } from '@src/data/neon-functions';

export function getStaticPaths() {
  return neonFunctions.map((func) => ({ params: { func: func.name }, props: { func } }));
}

const { func } = Astro.props;
const category = neonCategories[func.category];
Astro.locals.side = func.side;
const sourceUrl = `https://github.com/Dryxio/mtasa-neon/blob/master/${func.source}`;
const commitUrl = `https://github.com/Dryxio/mtasa-neon/commit/${func.commit}`;
const testPath = func.test === undefined ? category.test : func.test;
---

<StarlightPage frontmatter={{ template: 'doc', title: func.name, description: func.summary, tableOfContents: true }}>
  <div class="neon-function-banner">
    <div><span>NEON {func.extension ? 'EXTENSION' : 'API'}</span><a href={`/neon/functions#${func.category}`}>{category.title}</a></div>
    <p>{func.extension ? 'A standard MTA API with Neon behavior' : 'Available in Neon, not standard MTA'}</p>
  </div>

  <p class="summary">{func.summary}</p>

  <h2 id="syntax">Syntax</h2>
  <Code code={func.signature} lang="lua" />

  {func.nativeTask && <>
    <h2 id="gta-task-mapping">GTA task mapping</h2>
    <div class="native-task">
      <div class="native-task-header">
        <span>{func.nativeTask.tasks?.length ? 'ORIGINAL GTA TASK' : 'NATIVE GTA BEHAVIOR'}</span>
        {func.nativeTask.opcode && <code>{func.nativeTask.opcode}</code>}
      </div>
      {func.nativeTask.tasks?.length
        ? <div class="native-task-names">{func.nativeTask.tasks.map((task) => <code>{task}</code>)}</div>
        : <strong>No CTask is created</strong>}
      {func.nativeTask.command && <p class="native-command">SCM equivalent: <code>{func.nativeTask.command}</code></p>}
      <p>{func.nativeTask.note}</p>
    </div>
  </>}

  {func.arguments && func.arguments.length > 0 && <>
    <h2 id="arguments">Arguments</h2>
    <div class="argument-list">
      {func.arguments.map((argument) => <div>
        <div><code>{argument.name}</code><span>{argument.type}</span>{argument.optional && <em>optional{argument.default ? ` · default ${argument.default}` : ''}</em>}</div>
        <p>{argument.description}</p>
      </div>)}
    </div>
  </>}

  <h2 id="returns">Returns</h2>
  <p>{func.returns}</p>

  <h2 id="ownership-and-lifecycle">Ownership and lifecycle</h2>
  <p>{category.lifecycle}</p>

  {func.notes && func.notes.length > 0 && <div class="notes"><strong>Important behavior</strong><ul>{func.notes.map((note) => <li>{note}</li>)}</ul></div>}

  {func.oop && func.oop.length > 0 && <>
    <h2 id="oop">OOP aliases</h2>
    <ul>{func.oop.map((alias) => <li><code>{alias}</code></li>)}</ul>
  </>}

  {func.example && <>
    <h2 id="example">Example</h2>
    <Code code={func.example} lang="lua" />
  </>}

  <h2 id="implementation-evidence">Where this comes from</h2>
  <div class="evidence-grid">
    <a href={sourceUrl}><span>SOURCE</span><strong>{func.source.split('/').pop()}</strong><small>{func.source}</small></a>
    <a href={commitUrl}><span>INTRODUCED / EXTENDED</span><strong>{func.commit}</strong><small>Read the commit and why the change was made</small></a>
    {testPath && <a href={`https://github.com/Dryxio/mtasa-neon/tree/master/${testPath}`}><span>TEST RESOURCE</span><strong>{testPath.split('/').pop()}</strong><small>{testPath}</small></a>}
  </div>

  <p class="back-link"><a href="/neon/functions">← Back to the Neon Lua API</a> · <a href={category.guide}>How {category.title} works →</a></p>
</StarlightPage>

<style>
  .neon-function-banner { display: flex; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; border: 1px solid rgba(242,140,24,.38); border-radius: .2rem; background: rgba(242,140,24,.065); }
  .neon-function-banner div { display: flex; align-items: center; gap: .7rem; }
  .neon-function-banner span { padding: .22rem .45rem; color: #0a0806; background: #f28c18; border-radius: .12rem; font-size: .65rem; font-weight: 900; letter-spacing: .08em; }
  .neon-function-banner a { color: #ffad35; font-weight: 700; }
  .neon-function-banner p { margin: 0; color: var(--sl-color-gray-3); font-size: .8rem; }
  .summary { margin: 2rem 0; font-size: 1.2rem; color: var(--sl-color-gray-2); }
  .argument-list { display: grid; gap: .65rem; }
  .argument-list > div { padding: .9rem 1rem; border-left: 2px solid rgba(242,140,24,.62); background: var(--sl-color-bg-nav); }
  .argument-list > div > div { display: flex; flex-wrap: wrap; align-items: center; gap: .55rem; }
  .argument-list span { color: #ffad35; font-family: monospace; font-size: .78rem; }
  .argument-list em { color: var(--sl-color-gray-3); font-size: .74rem; }
  .argument-list p { margin: .4rem 0 0; }
  .native-task { padding: 1rem 1.1rem; border: 1px solid rgba(242,140,24,.36); border-left: 3px solid #f28c18; border-radius: .35rem; background: linear-gradient(110deg, rgba(242,140,24,.08), rgba(10,8,6,.08)); }
  .native-task-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
  .native-task-header span { color: #f28c18; font-size: .67rem; font-weight: 900; letter-spacing: .1em; }
  .native-task-header > code { color: #ffbd5c; }
  .native-task-names { display: flex; flex-wrap: wrap; gap: .5rem; }
  .native-task-names code { min-width: 0; max-width: 100%; padding: .35rem .55rem; overflow-wrap: anywhere; white-space: normal; border: 1px solid rgba(242,140,24,.25); background: rgba(242,140,24,.08); color: #ffd08b; }
  .native-task > strong { color: var(--sl-color-gray-2); }
  .native-task p { margin: .75rem 0 0; }
  .native-task .native-command { color: var(--sl-color-gray-3); font-size: .88rem; }
  .notes { margin: 1.5rem 0; padding: 1rem 1.2rem; border: 1px solid rgba(245,194,107,.35); border-radius: .7rem; background: rgba(245,194,107,.06); }
  .notes ul { margin-bottom: 0; }
  .evidence-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: .7rem; }
  .evidence-grid a { display: flex; flex-direction: column; min-width: 0; padding: 1rem; color: inherit; text-decoration: none; border: 1px solid var(--sl-color-gray-5); border-radius: .7rem; }
  .evidence-grid a:hover { border-color: #f28c18; transform: translateY(-2px); }
  .evidence-grid span { color: #f28c18; font-size: .62rem; font-weight: 900; letter-spacing: .1em; }
  .evidence-grid strong { margin: .35rem 0; }
  .evidence-grid small { overflow-wrap: anywhere; color: var(--sl-color-gray-3); }
  .back-link { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--sl-color-gray-5); }
  @media (max-width: 760px) { .neon-function-banner { flex-direction: column; } .evidence-grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { :global(h1.page-title) { font-size: 1.625rem !important; line-height: 1.15 !important; } }
</style>
