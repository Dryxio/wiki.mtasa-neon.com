---
import { CardGrid } from '@astrojs/starlight/components';
import IconLinkCard from '@src/components/IconLinkCard.astro';
---

<div data-pagefind-ignore class="neon-footer-links">
  <p>CONTINUE OUTSIDE NEON</p>
  <CardGrid>
    <IconLinkCard
      icon="seti:powershell"
      iconColor="#f28c18"
      title="Official MTA Wiki"
      titleColor="#f28c18"
      description="Standard MTA APIs, events, elements, and scripting concepts."
      href="https://wiki.multitheftauto.com/wiki/Main_Page" />

    <IconLinkCard
      icon="seti:purescript"
      iconColor="#f28c18"
      title="MTA scripting functions"
      titleColor="#f28c18"
      description="Canonical reference for the APIs provided by standard MTA."
      href="https://wiki.multitheftauto.com/wiki/Scripting_Functions" />

    <IconLinkCard
      icon="github"
      iconColor="#f28c18"
      title="Neon engine source"
      titleColor="#f28c18"
      description="Inspect the implementation, commits, and focused test resources."
      href="https://github.com/Dryxio/mtasa-neon" />
  </CardGrid>
</div>

<style>
  .neon-footer-links { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid #3a2b1d; }
  .neon-footer-links > p { color: #f28c18; font-size: .64rem; font-weight: 900; letter-spacing: .17em; }
</style>
